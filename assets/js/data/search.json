---
layout: compress
---
[
  {% assign docs = site.pages | where: "methodology", true %}
  {% assign oscp_docs = site.pages | where: "oscp", true %}
  {% assign all = site.posts | concat: docs | concat: oscp_docs %}
  {% for item in all %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "categories": {{ item.categories | join: ', ' | jsonify }},
    "tags": {{ item.tags | join: ', ' | jsonify }},
    "content": {{ item.content | strip_html | strip_newlines | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
